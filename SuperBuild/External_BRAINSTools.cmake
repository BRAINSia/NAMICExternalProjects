set(proj BRAINSTools)

set(${proj}_DEPENDENCIES ITKv5 SlicerExecutionModel teem)
if(USE_ANTS)
  list(APPEND ${proj}_DEPENDENCIES ANTs)
endif()
if(${SUPERBUILD_TOPLEVEL_PROJECT}_REQUIRES_VTK)
  list(APPEND ${proj}_DEPENDENCIES VTK)
endif()
if(${SUPERBUILD_TOPLEVEL_PROJECT}_REQUIRES_TBB)
  list(APPEND ${proj}_DEPENDENCIES tbb)
endif()

ExternalProject_Include_Dependencies(${proj} PROJECT_VAR proj DEPENDS_VAR ${proj}_DEPENDENCIES)

set(${proj}_CMAKE_OPTIONS
  ${EXTERNAL_PROJECT_DEFAULTS}
  -DCMAKE_CXX_STANDARD:STRING=${CMAKE_CXX_STANDARD}
  -DCMAKE_CXX_STANDARD_REQUIRED:BOOL=${CMAKE_CXX_STANDARD_REQUIRED}
  -DCMAKE_CXX_EXTENSIONS:BOOL=${CMAKE_CXX_EXTENSIONS}
  -DCMAKE_INSTALL_PREFIX:PATH=${CMAKE_CURRENT_BINARY_DIR}/${proj}-install
  -DBRAINSTools_SUPERBUILD:BOOL=OFF
  -DBRAINSTools_REQUIRES_VTK:BOOL=${${SUPERBUILD_TOPLEVEL_PROJECT}_REQUIRES_VTK}
  -DBRAINSTools_REQUIRES_TBB:BOOL=${${SUPERBUILD_TOPLEVEL_PROJECT}_REQUIRES_TBB}
  -DBRAINSTools_BUILD_DICOM_SUPPORT:BOOL=${${SUPERBUILD_TOPLEVEL_PROJECT}_BUILD_DICOM_SUPPORT}
  -DUSE_SYSTEM_ITK:BOOL=ON
  -DITK_DIR:PATH=${ITK_DIR}
  -DUSE_SYSTEM_SlicerExecutionModel:BOOL=ON
  -DSlicerExecutionModel_DIR:PATH=${SlicerExecutionModel_DIR}
  -DUSE_SYSTEM_VTK:BOOL=ON
  -DVTK_DIR:PATH=${VTK_DIR}
  -DUSE_SYSTEM_Teem:BOOL=ON
  -DTeem_DIR:PATH=${Teem_DIR}
  -DTBB_DIR:PATH=${TBB_DIR}
  -DUSE_SYSTEM_ZLIB:BOOL=ON
  -DZLIB_ROOT:PATH=${ZLIB_ROOT}
  -DZLIB_INCLUDE_DIR:PATH=${ZLIB_INCLUDE_DIR}
  -DZLIB_LIBRARY:FILEPATH=${ZLIB_LIBRARY}
  -DUSE_ANTS:BOOL=${USE_ANTS}
  -DUSE_SYSTEM_ANTs:BOOL=ON
  -DANTS_DIR:PATH=${ANTS_DIR}
  -DUSE_AutoWorkup:BOOL=ON
  -DUSE_BRAINSABC:BOOL=${${SUPERBUILD_TOPLEVEL_PROJECT}_REQUIRES_TBB}
  -DUSE_GTRACT:BOOL=${${SUPERBUILD_TOPLEVEL_PROJECT}_REQUIRES_VTK}
  -DUSE_DebugImageViewer:BOOL=OFF
  -DBUILD_TESTING:BOOL=OFF
  )

# HINT: -D${CMAKE_PROJECT_NAME}_${proj}_GIT_TAG:STRING=<branch-or-sha> to override
ExternalProject_SetIfNotDefined(
  ${CMAKE_PROJECT_NAME}_${proj}_GIT_REPOSITORY
  "${git_protocol}://github.com/BRAINSia/BRAINSTools.git"
  QUIET
  )
ExternalProject_SetIfNotDefined(
  ${CMAKE_PROJECT_NAME}_${proj}_GIT_TAG
  506631a013ca99bc4ab91a8b80229038ba5e28fb # main 2026-11-08
  QUIET
  )

ExternalProject_Add(${proj}
  ${${proj}_EP_ARGS}
  GIT_REPOSITORY "${${CMAKE_PROJECT_NAME}_${proj}_GIT_REPOSITORY}"
  GIT_TAG "${${CMAKE_PROJECT_NAME}_${proj}_GIT_TAG}"
  GIT_SHALLOW ${${SUPERBUILD_TOPLEVEL_PROJECT}_EP_GIT_SHALLOW}
  UPDATE_DISCONNECTED TRUE
  SOURCE_DIR ${SOURCE_DOWNLOAD_CACHE}/${proj}
  BINARY_DIR ${proj}-build
  LOG_CONFIGURE ON
  LOG_BUILD ON
  LOG_INSTALL ON
  LOG_OUTPUT_ON_FAILURE ON
  CMAKE_ARGS -Wno-dev --no-warn-unused-cli
  CMAKE_CACHE_ARGS
    ${${proj}_CMAKE_OPTIONS}
  DEPENDS
    ${${proj}_DEPENDENCIES}
  )

set(${proj}_DIR ${CMAKE_BINARY_DIR}/${proj}-build)
set(${proj}_SOURCE_DIR ${SOURCE_DOWNLOAD_CACHE}/${proj})
set(BRAINSCommonLib_DIR ${CMAKE_BINARY_DIR}/${proj}-build/BRAINSCommonLib)

mark_as_superbuild(
  VARS ${proj}_DIR:PATH ${proj}_SOURCE_DIR:PATH BRAINSCommonLib_DIR:PATH
  LABELS "FIND_PACKAGE"
  )
